# Copy to .env (scripts/setup.sh does it). Never commit real secrets.
ENV=dev

# --- Postgres (docker-compose; must match DATABASE_URL) ---
POSTGRES_USER=payproof
POSTGRES_PASSWORD=payproof
POSTGRES_DB=payproof
POSTGRES_PORT=5432

# --- API ---
DATABASE_URL=postgresql+asyncpg://payproof:payproof@localhost:5432/payproof
JWT_SECRET=dev-only-change-me
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_MB=20
MAX_PAGES=50

# --- Storage (MinIO locally) ---
# MINIO_PORT must match the port in S3_ENDPOINT_URL
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=payproof
S3_SECRET_KEY=payproof-secret
S3_BUCKET=payproof-docs
SIGNED_URL_TTL_SECONDS=300

# --- Extraction / AI ---
# ADR-0011 §5 — switching provider is env-only.
# mock | pdf | anthropic | openai
#   mock      pre-processed demo results (labelled), no key
#   pdf       invoice PDF text layer only (transition; configured document types read as unread)
#   anthropic Claude via the official SDK — AI_API_KEY required (startup fails without it)
#   openai    same interface, stub for now (configuration is checked; extraction not implemented)
AI_PROVIDER=mock
# Server-side only; never exposed to the frontends, never logged.
AI_API_KEY=
# Provider model id; empty = the adapter default (anthropic: claude-opus-5-5).
AI_MODEL=
# Optional: proxy or compatible endpoint; empty = the provider's default URL.
AI_BASE_URL=
# Per request (seconds) and SDK retries on 408/409/429/5xx and connection errors.
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
# Below this confidence a value is stored as unread (a person reads it) — never guessed.
AI_MIN_CONFIDENCE=0.8

# --- Export e-mail (ADR-0011 §4, Resend) ---
# Exports with an output template are e-mailed to the requirement set's address only.
# Empty key: dev/test log instead of sending; prod marks the submission FAILED.
RESEND_API_KEY=
RESEND_FROM=PayProof <hesabat@payproof.az>

# --- Frontends ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MOCK=1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
