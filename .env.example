# Copy to .env (scripts/setup.sh does it). Never commit real secrets.
ENV=dev

# --- Postgres (docker-compose; must match DATABASE_URL) ---
POSTGRES_USER=payproof
POSTGRES_PASSWORD=payproof
POSTGRES_DB=payproof
POSTGRES_PORT=5432

# --- API ---
DATABASE_URL=postgresql+asyncpg://payproof:payproof@localhost:5432/payproof
JWT_SECRET=dev-only-change-me
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_MB=20
MAX_PAGES=50

# --- Storage (MinIO locally) ---
# MINIO_PORT must match the port in S3_ENDPOINT_URL
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=payproof
S3_SECRET_KEY=payproof-secret
S3_BUCKET=payproof-docs
SIGNED_URL_TTL_SECONDS=300

# --- Extraction / AI ---
# ADR-0011 §5 — switching provider is env-only.
# mock | anthropic | openai   (mock = pre-processed results, labelled in UI; no key needed)
# The backend still accepts `pdf` (text layer only) until the provider step lands.
AI_PROVIDER=mock
# Server-side only; never exposed to the frontends.
AI_API_KEY=
# Provider model id, e.g. a Claude or GPT model name.
AI_MODEL=
# Optional: proxy or OpenAI-compatible endpoint; empty = the provider's default URL.
AI_BASE_URL=

# --- Frontends ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MOCK=1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
