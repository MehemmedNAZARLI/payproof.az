    },
    {
      "name": "receipt_line_items_and_totals",
      "package": "QR-2026-0914",
      "ops": [
        {
          "op": "add",
          "document": {
            "id": "unec_0914_receipt",
            "type": "receipt",
            "file_name": "qebz-0412.jpg",
            "pages": 1,
            "fields": {
              "merchant": { "name": "Kitab Evi", "tax_id": "1403216781" },
              "receipt_number": "0412",
              "receipt_date": "2026-09-12",
              "currency": "AZN",
              "total": "135.01"
            },
            "unreadable": [],
            "tables": {
              "lines": [
                { "description": "Makroiqtisadiyyat dərsliyi", "qty": "2", "amount": "135.00" },
                { "description": "Qələm", "qty": null, "amount": "1.00" }
              ]
            },
            "evidence": {
              "merchant": { "page": 1, "quote": "KITAB EVI VÖEN 1403216781" },
              "receipt_number": { "page": 1, "quote": "Qəbz № 0412" },
              "receipt_date": { "page": 1, "quote": "12.09.2026" },
              "currency": { "page": 1, "quote": "AZN" },
              "total": { "page": 1, "quote": "CƏMİ 135.01" },
              "lines[0]": { "page": 1, "quote": "Makroiqtisadiyyat dərsliyi 2 135.00" }
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-01",
            "type": "line_items_match",
            "title": "Qəbz sətirləri fakturaya uyğundur",
            "parameters": {
              "left": { "document_type": "receipt", "table": "lines" },
              "right": { "document_type": "invoice", "table": "lines" },
              "key_column": "description",
              "compare": ["qty", "amount"],
              "tolerance": "0.00"
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-02",
            "type": "values_equal",
            "title": "Qəbz və faktura yekunu eynidir",
            "parameters": {
              "fields": [
                { "document_type": "receipt", "field": "total" },
                { "document_type": "invoice", "field": "total" }
              ],
              "tolerance": "0.01"
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-03",
            "type": "party_identity_match",
            "title": "Qəbz satıcısı fakturadakıdır",
            "parameters": {
              "parties": [
                { "document_type": "receipt", "field": "merchant" },
                { "document_type": "invoice", "field": "seller" }
              ],
              "match_on": ["tax_id", "name"]
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-04",
            "type": "values_equal",
            "title": "Qəbz nömrəsi (casefold)",
            "parameters": {
              "fields": [
                { "document_type": "receipt", "field": "receipt_number" },
                { "document_type": "contract", "field": "contract_number" }
              ],
              "normalize": "casefold"
            }
          }
        }
      ]
    },
    {
      "name": "checks_without_documents",
      "package": "QR-2026-0914",
      "ops": [
        {
          "op": "add_check",
          "check": {
            "id": "X-05",
            "type": "field_present",
            "title": "Müqavilə nömrəsi",
            "parameters": {
              "targets": [{ "document_type": "contract", "field": "contract_number" }]
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-06",
            "type": "totals_sum",
            "title": "Qəbz cəmi",
            "parameters": {
              "document_type": "receipt",
              "table": "lines",
              "amount_column": "amount",
              "total_field": "total",
              "tolerance": "0.00"
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-07",
            "type": "transaction_match",
            "title": "Qəbz ödənişi",
            "parameters": {
              "source": {
                "document_type": "receipt",
                "amount_field": "total",
                "date_field": "receipt_date",
                "counterparty_field": "merchant.name"
              },
              "against": [{ "document_type": "card_statement", "list": "transactions" }],
              "amount_tolerance": "0.00",
              "date_window_days": 3,
              "counterparty": "normalized",
              "direction": "debit"
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-08",
            "type": "line_items_match",
            "title": "Sətirlər",
            "parameters": {
              "left": { "document_type": "receipt", "table": "lines" },
              "right": { "document_type": "invoice", "table": "lines" },
              "key_column": "description",
              "compare": ["amount"]
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-09",
            "type": "no_duplicate_use",
            "title": "Qəbz təkrarı",
            "parameters": {
              "subjects": [{ "document_type": "receipt", "key_fields": ["receipt_number"] }],
              "scope": "package"
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-10",
            "type": "date_within_period",
            "title": "Qəbz tarixi",
            "parameters": {
              "target": { "document_type": "receipt", "field": "receipt_date" },
              "period": { "from": "2026-09-01", "to": "2026-10-31" }
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-11",
            "type": "amount_within_limit",
            "title": "Qəbz limiti",
            "parameters": {
              "target": { "document_type": "receipt", "field": "total" },
              "aggregate": "each",
              "limit": { "amount": "100.00", "currency": "AZN" }
            }
          }
        },
        {
          "op": "add_check",
          "check": {
            "id": "X-12",
            "type": "party_identity_match",
            "title": "Bir tərəf",
            "parameters": {
              "parties": [{ "document_type": "card_statement", "field": "card_holder" }],
              "match_on": ["name"]
            }
          }
        }
      ]
    }
  ]
