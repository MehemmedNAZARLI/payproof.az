            "title": "Məcburi sahələr çıxarılıb",
            "parameters": {
              "targets": [
                {
                  "document_type": "invoice",
                  "field": "invoice_number"
                },
                {
                  "document_type": "invoice",
                  "field": "invoice_date"
                },
                {
